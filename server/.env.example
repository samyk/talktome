# Listen TTS Server
LISTEN_HOST=127.0.0.1
LISTEN_PORT=8765
# auto | edge | kokoro | qwen3 | moss | omnivoice | editx | system
LISTEN_ENGINE=auto
LISTEN_FALLBACK_ENGINE=kokoro
LISTEN_DEFAULT_VOICE_ID=edge:en-US-AriaNeural
LISTEN_EDGE_DEFAULT_VOICE=en-US-AriaNeural

# MOSS-TTS (OpenAI-compat URL from SGLang-Omni / vLLM-Omni, or local HF path)
# LISTEN_MOSS_URL=http://127.0.0.1:8000/v1
# LISTEN_MOSS_MODEL_PATH=OpenMOSS-Team/MOSS-TTS-Local-Transformer-v1.5

# Qwen3-TTS
# LISTEN_QWEN3_URL=http://127.0.0.1:8001/v1
# LISTEN_QWEN3_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice
# LISTEN_QWEN3_VOICE=Vivian

# OmniVoice
# LISTEN_OMNIVOICE_URL=http://127.0.0.1:8002/v1
# LISTEN_OMNIVOICE_MODEL=k2-fsa/OmniVoice

# Step-Audio-EditX (CUDA)
# LISTEN_EDITX_REPO=/path/to/Step-Audio-EditX
# LISTEN_EDITX_MODEL_PATH=/path/to/Step-Audio-EditX-AWQ-4bit
# LISTEN_EDITX_TOKENIZER_PATH=/path/to/Step-Audio-Tokenizer
